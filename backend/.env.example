# =========================================================================
# GIRI PROJECT - EMAIL API CONFIGURATION
# =========================================================================
# Copy this file to '.env' and fill in your credentials.
# The server will automatically detect whether you are using Resend or Gmail.

PORT=5000

# Where you want to receive the callback / contact form submissions
TO_EMAIL=your_receiving_email@example.com

# -------------------------------------------------------------------------
# OPTION A: RESEND CONFIGURATION (Recommended)
# -------------------------------------------------------------------------
# Sign up at https://resend.com to get an API key.
# Note: In development, if you don't verify a custom domain, you can only
# send from 'onboarding@resend.dev' to your registered account email.

RESEND_API_KEY=re_123456789abcde

# The sender address. Must be 'onboarding@resend.dev' or a verified domain address.
FROM_EMAIL=onboarding@resend.dev

# -------------------------------------------------------------------------
# OPTION B: GMAIL SMTP CONFIGURATION (Alternative)
# -------------------------------------------------------------------------
# To use Gmail, you must:
# 1. Enable 2-Step Verification on your Google Account.
# 2. Go to Google Account Security -> App Passwords.
# 3. Generate a 16-character app password (e.g. "abcd efgh ijkl mnop").
# 4. Fill in the fields below (comment out the RESEND fields above if using Gmail).

GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASS=your_16_char_app_password
