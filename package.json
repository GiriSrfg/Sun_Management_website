{
  "name": "giri-project-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm install --workspaces --if-present",
    "dev-frontend": "npm run dev --workspace=frontend",
    "dev-backend": "npm run dev --workspace=backend",
    "dev": "npx concurrently \"npm run dev-frontend\" \"npm run dev-backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
